# Development environment variables
# Copy this file to .env and fill in values

DATABASE_URL=
JWT_SECRET=
APP_PORT=8080
ENABLE_DEMO=true
RECURRENCY_API_URL=http://localhost:8080

# Set to "production" to lower the default log level to warn
APP_ENV=development

# Set to "false" to disable frontend UI serving (API-only mode)
ENABLE_WEB=true