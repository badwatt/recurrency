#!/usr/bin/env bash
set -euo pipefail

# ── Recurrency Taskfile ───────────────────────────────────
# Usage: ./taskfile [command]
#
# Commands:
#   up        Start everything (DB + backend + frontend)
#   down      Stop everything
#   test      Run all tests with coverage
#   coverage  Show coverage report
#   reset     Reset database (⚠️  deletes all data)
#   backend   Start backend only
#   frontend  Start frontend only
#   db        Start PostgreSQL only
#   css       Build Tailwind CSS
#   android:build  Build Android APK (auto-setup SDK if needed)
#   help      Show this help

# ── Colors ──────────────────────────────────────────────
Y=$'\033[1;33m'
G=$'\033[1;32m'
C=$'\033[1;36m'
R=$'\033[0;31m'
N=$'\033[0m'

info()  { printf '%s→ %s%s\n' "$C" "$1" "$N"; }
ok()    { printf '%s✓ %s%s\n' "$G" "$1" "$N"; }
warn()  { printf '%s⚠ %s%s\n' "$Y" "$1" "$N"; }
err()   { printf '%s✗ %s%s\n' "$R" "$1" "$N"; exit 1; }

ROOT="$(cd "$(dirname "$0")" && pwd)"

# ── Start ───────────────────────────────────────────────
cmd_up() {
  info "Killing stale processes..."
  pkill -f "cargo run" 2>/dev/null || true
  pkill -f "dx serve" 2>/dev/null || true
  sleep 1

  info "Starting PostgreSQL..."
  cd "$ROOT" && docker compose -f docker-compose.dev.yml up -d 2>/dev/null || true
  ok "DB running"

  info "Building CSS..."
  cd "$ROOT/frontend" && npx tailwindcss -i assets/tailwind.src.css -o public/tailwind.css --minify 2>/dev/null || true

  info "Starting backend..."
  cd "$ROOT/backend"
  export APP_HOST="${APP_HOST:-localhost}"
  export APP_PORT="${APP_PORT:-8080}"
  export JWT_SECRET="${JWT_SECRET:-dev-secret}"
  export ENABLE_DEMO="${ENABLE_DEMO:-true}"
  export FRONTEND_DIST="$ROOT/frontend/public"
  nix develop "$ROOT" -c cargo run &
  BACKEND_PID=$!

  info "Starting frontend..."
  cd "$ROOT/frontend"
  export RECURRENCY_API_URL="${RECURRENCY_API_URL:-http://localhost:8080}"
  nix develop "$ROOT" -c dx serve --platform web --port 1420 &
  FRONTEND_PID=$!

  trap "kill $BACKEND_PID $FRONTEND_PID 2>/dev/null; cd $ROOT && docker compose -f docker-compose.dev.yml down 2>/dev/null" EXIT

  ok "All running:"
  echo "  • Frontend: http://localhost:1420"
  echo "  • Backend:  http://localhost:8080"
  echo "  • Database: localhost:5432"
  echo ""
  warn "First frontend load: ~30s (58MB WASM download + compile)"
  warn "Ctrl+C to stop"
  wait
}

# ── Stop ────────────────────────────────────────────────
cmd_down() {
  info "Stopping..."
  pkill -f "cargo run" 2>/dev/null || true
  pkill -f "dx serve" 2>/dev/null || true
  cd "$ROOT" && docker compose -f docker-compose.dev.yml down 2>/dev/null || true
  ok "All stopped"
}

# ── Tests ──────────────────────────────────────────────
cmd_test() {
  info "Backend tests..."
  cd "$ROOT/backend" && nix develop "$ROOT" -c cargo test --lib || warn "Backend tests failed"

  echo ""
  info "Frontend tests..."
  cd "$ROOT/frontend" && nix develop "$ROOT" -c cargo test || warn "Frontend tests failed"

  ok "Tests done"
}

# ── Coverage ───────────────────────────────────────────
cmd_coverage() {
  info "Backend coverage..."
  cd "$ROOT/backend" && nix develop "$ROOT" -c cargo llvm-cov test --lib 2>&1 | tail -1

  echo ""
  info "Frontend coverage..."
  cd "$ROOT/frontend" && nix develop "$ROOT" -c cargo llvm-cov test 2>&1 | tail -1
}

# ── Reset DB ─────────────────────────────────────────
cmd_reset() {
  warn "This DELETES all data!"
  read -rp "Confirm [y/N]: " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { ok "Cancelled"; exit 0; }

  info "Resetting..."
  cd "$ROOT" && docker compose -f docker-compose.dev.yml down -v 2>/dev/null || true
  docker compose -f docker-compose.dev.yml up -d
  cd "$ROOT/backend" && nix develop "$ROOT" -c sqlx migrate run 2>/dev/null || true
  ok "Database reset"
}

# ── Individual ─────────────────────────────────────────
cmd_backend()  { cd "$ROOT/backend"  && nix develop "$ROOT" -c cargo run; }
cmd_frontend() { cd "$ROOT/frontend" && nix develop "$ROOT" -c dx serve --platform web --port 1420; }
cmd_db()       { cd "$ROOT" && docker compose -f docker-compose.dev.yml up -d && ok "DB running on 5432"; }
cmd_css()      { cd "$ROOT/frontend" && npx tailwindcss -i assets/tailwind.src.css -o public/tailwind.css --minify && ok "CSS built"; }

# ── Android ────────────────────────────────────────────
_check_android_env() {
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
    ANDROID_HOME="${HOME}/.android-sdk"
    if [ ! -d "$ANDROID_HOME/platforms" ]; then
      info "Android SDK not found. Running setup..."
      bash "$ROOT/scripts/setup-android-env.sh"
    fi
  fi
}

cmd_android_build() {
  _check_android_env
  info "Building Android APK..."
  cd "$ROOT" && bash scripts/build-android.sh
}

cmd_android_clean() {
  info "Cleaning Android build..."
  cd "$ROOT/frontend"
  rm -rf android android-studio .gradle app/build build 2>/dev/null || true
  ok "Android build cleaned"
}

# ── Help ───────────────────────────────────────────────
cmd_help() {
  cat <<EOF
${C}Recurrency Taskfile${N}

${Y}Usage:${N} ./taskfile [command]

${G}Main:${N}
  up        Start everything (DB + backend + frontend)
  down      Stop everything
  test      Run all tests
  coverage  Show coverage report
  reset     Reset database (⚠️  deletes data)

${G}Individual:${N}
  backend   Start backend only (port 8080)
  frontend  Start frontend only (port 1420)
  db        Start PostgreSQL only (port 5432)
  css       Build Tailwind CSS once

${G}Android:${N}
  android:build  Build Android APK (auto-setup SDK if needed)
  android:clean  Clean Android build artifacts

${Y}Examples:${N}
  ./taskfile up           # Start all
  ./taskfile test         # Run tests
  ./taskfile coverage     # Check coverage
  ./taskfile reset        # Clean database
  ./taskfile android:build  # Build APK
EOF
}

# ── Dispatch ──────────────────────────────────────────
case "${1:-help}" in
  up)           cmd_up ;;
  down|stop)    cmd_down ;;
  test)         cmd_test ;;
  coverage)     cmd_coverage ;;
  reset)        cmd_reset ;;
  backend)      cmd_backend ;;
  frontend)     cmd_frontend ;;
  db)           cmd_db ;;
  css)          cmd_css ;;
  android)      cmd_android_build ;;
  android:build) cmd_android_build ;;
  android:clean) cmd_android_clean ;;
  help|*)       cmd_help ;;
esac