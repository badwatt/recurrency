#!/usr/bin/env bash
set -euo pipefail

# ── Recurrency Taskfile ───────────────────────────────────
# Usage: ./taskfile [command]
#
# Commands:
#   up        Start everything (DB + backend + frontend)
#   down      Stop everything
#   test      Run all tests with coverage
#   coverage  Show coverage report
#   reset     Reset database (⚠️  deletes all data)
#   backend   Start backend only
#   frontend  Start frontend only
#   db        Start PostgreSQL only
#   css       Build Tailwind CSS
#   android:build  Build Android APK (auto-setup SDK if needed)
#   help      Show this help

# ── Colors ──────────────────────────────────────────────
Y=$'\033[1;33m'
G=$'\033[1;32m'
C=$'\033[1;36m'
R=$'\033[0;31m'
N=$'\033[0m'

info()  { printf '%s→ %s%s\n' "$C" "$1" "$N"; }
ok()    { printf '%s✓ %s%s\n' "$G" "$1" "$N"; }
warn()  { printf '%s⚠ %s%s\n' "$Y" "$1" "$N"; }
err()   { printf '%s✗ %s%s\n' "$R" "$1" "$N"; exit 1; }

ROOT="$(cd "$(dirname "$0")" && pwd)"

# ── Start ───────────────────────────────────────────────
cmd_up() {
  info "Killing stale processes..."
  pkill -f "recurrency-api" 2>/dev/null || true
  pkill -f "cargo run" 2>/dev/null || true
  pkill -f "dx serve" 2>/dev/null || true
  # kill any process on port 8080
  fuser -k 8080/tcp 2>/dev/null || true
  sleep 1

  info "Starting PostgreSQL..."
  cd "$ROOT" && docker compose -f docker/docker-compose.dev.yml up -d 2>&1 || warn "docker compose failed, PostgreSQL may not start"

  info "Waiting for PostgreSQL to be ready..."
  for i in $(seq 1 30); do
    if pg_isready -h localhost -p 5432 -U recurrency -d recurrency >/dev/null 2>&1; then
      ok "PostgreSQL ready"
      break
    fi
    if [ "$i" -eq 30 ]; then
      warn "pg_isready not available or DB slow, checking container..."
      cd "$ROOT" && docker compose -f docker/docker-compose.dev.yml ps 2>/dev/null || true
      err "PostgreSQL not ready after 30s. Run: docker compose -f docker/docker-compose.dev.yml logs db"
    fi
    sleep 1
  done

  info "Building CSS..."
  cd "$ROOT/frontend" && npx tailwindcss -i assets/styles/tailwind.src.css -o assets/styles/tailwind.css --minify 2>/dev/null || true

  info "Building frontend (dist)..."
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx bundle --platform web 2>/dev/null || true
  if [ ! -f "$ROOT/frontend/dist/public/index.html" ]; then
    warn "dx bundle output not found at dist/public/, trying target/dx/ fallback..."
    find "$ROOT/frontend/target/dx" -name 'index.html' -path '*/web/public/*' | head -1 | xargs -I {} cp -r "$(dirname {})" "$ROOT/frontend/dist/public" 2>/dev/null || true
  fi
  if [ ! -f "$ROOT/frontend/dist/public/index.html" ]; then
    err "Frontend build failed: no index.html found"
  fi

  info "Starting backend..."
  cd "$ROOT/backend"
  export APP_HOST="${APP_HOST:-localhost}"
  export APP_PORT="${APP_PORT:-8080}"
  export JWT_SECRET="${JWT_SECRET:-dev-secret}"
  export ENABLE_DEMO="${ENABLE_DEMO:-true}"
  export FRONTEND_DIST="$ROOT/frontend/dist/public"
  nix develop --no-eval-cache "$ROOT" -c cargo run &
  BACKEND_PID=$!

  info "Starting frontend..."
  cd "$ROOT/frontend"
  export RECURRENCY_API_URL="${RECURRENCY_API_URL:-http://localhost:8080}"
  nix develop --no-eval-cache "$ROOT" -c dx serve --platform web --port 1420 &
  FRONTEND_PID=$!

  trap "kill $BACKEND_PID $FRONTEND_PID 2>/dev/null; cd $ROOT && docker compose -f docker/docker-compose.dev.yml down 2>/dev/null" EXIT

  ok "All running:"
  echo "  • Frontend: http://localhost:1420"
  echo "  • Backend:  http://localhost:8080"
  echo "  • Database: localhost:5432"
  echo ""
  warn "First frontend load: ~30s (58MB WASM download + compile)"
  warn "Ctrl+C to stop"
  wait
}

# ── Stop ────────────────────────────────────────────────
cmd_down() {
  info "Stopping..."
  pkill -f "recurrency-api" 2>/dev/null || true
  pkill -f "cargo run" 2>/dev/null || true
  pkill -f "dx serve" 2>/dev/null || true
  fuser -k 8080/tcp 2>/dev/null || true
  cd "$ROOT" && docker compose -f docker/docker-compose.dev.yml down 2>/dev/null || true
  ok "All stopped"
}

# ── Tests ──────────────────────────────────────────────
cmd_test() {
  info "Backend tests..."
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c cargo test --lib || warn "Backend tests failed"

  echo ""
  info "Frontend tests..."
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c cargo test || warn "Frontend tests failed"

  ok "Tests done"
}

# ── Coverage ───────────────────────────────────────────
cmd_coverage() {
  info "Backend coverage..."
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c cargo llvm-cov test --lib 2>&1 | tail -1

  echo ""
  info "Frontend coverage..."
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c cargo llvm-cov test 2>&1 | tail -1
}

# ── Reset DB ─────────────────────────────────────────
cmd_reset() {
  warn "This DELETES all data!"
  read -rp "Confirm [y/N]: " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { ok "Cancelled"; exit 0; }

  info "Resetting..."
  fuser -k 8080/tcp 2>/dev/null || true
  cd "$ROOT" && docker compose -f docker/docker-compose.dev.yml down -v 2>/dev/null || true
  docker compose -f docker/docker-compose.dev.yml up -d
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c sqlx migrate run 2>/dev/null || true
  ok "Database reset"
}

# ── Individual ─────────────────────────────────────────
cmd_backend()  { cd "$ROOT/backend"  && nix develop --no-eval-cache "$ROOT" -c cargo run; }
cmd_frontend() { cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx serve --platform web --port 1420; }
cmd_db()       { cd "$ROOT" && docker compose -f docker/docker-compose.dev.yml up -d && ok "DB running on 5432"; }
cmd_css()      { cd "$ROOT/frontend" && npx tailwindcss -i assets/styles/tailwind.src.css -o assets/styles/tailwind.css --minify && ok "CSS built"; }

# ── Build ───────────────────────────────────────────────
cmd_build() {
  info "Building all..."
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c cargo build --release
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx bundle --platform web --release
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx bundle --platform desktop --release --out-dir ../bin/desktop 2>/dev/null || true
  ok "Build complete: backend + web + desktop"
  info "For Android APK: use build:android"
}

cmd_build_app() {
  info "Building web + api (all-in-one)..."
  mkdir -p "$ROOT/bin"
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx bundle --platform web --release
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c cargo build --release
  cp "$ROOT/backend/target/release/recurrency-api" "$ROOT/bin/recurrency-aio"
  ok "Build complete: bin/recurrency-aio"
}

cmd_build_api() {
  info "Building API..."
  mkdir -p "$ROOT/bin"
  cd "$ROOT/backend" && nix develop --no-eval-cache "$ROOT" -c cargo build --release
  cp "$ROOT/backend/target/release/recurrency-api" "$ROOT/bin/recurrency-aio"
  ok "API built: bin/recurrency-aio"
}

cmd_build_web() {
  info "Building web frontend..."
  cd "$ROOT/frontend" && nix develop --no-eval-cache "$ROOT" -c dx bundle --platform web --release
  ok "Web built: frontend/dist/"
  info "Embed in all-in-one: use build:app"
}

cmd_build_android() {
  _check_android_env
  info "Building Android APK..."
  cd "$ROOT" && bash scripts/build-android.sh --out-dir "$PWD/bin/android"
}

cmd_build_desktop() {
  info "Building desktop app..."
  cd "$ROOT/frontend" && nix develop "$ROOT" -c dx bundle --platform desktop --release --out-dir ../bin/desktop
}

cmd_clear() {
  info "Clearing all build artifacts..."
  rm -rf backend/target/release/recurrency-api 2>/dev/null || true
  rm -rf frontend/dist 2>/dev/null || true
  rm -rf bin/android bin/desktop 2>/dev/null || true
  rm -rf frontend/target 2>/dev/null || true
  ok "All build artifacts cleared"
}


# ── Android ────────────────────────────────────────────
_check_android_env() {
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
    ANDROID_HOME="${HOME}/.android-sdk"
    if [ ! -d "$ANDROID_HOME/platforms" ]; then
      info "Android SDK not found. Running setup..."
      bash "$ROOT/scripts/setup-android-env.sh"
    fi
  fi
}

cmd_clear_android() {
  info "Cleaning Android build..."
  rm -rf bin/android android android-studio .gradle app/build build 2>/dev/null || true
  ok "Android build cleaned"
}

cmd_clear_desktop() {
  info "Clearing desktop artifacts..."
  rm -rf bin/desktop 2>/dev/null || true
  ok "Desktop artifacts cleared"
}

cmd_clear_all() {
  info "Clearing all build artifacts..."
  cmd_clear
  cmd_clear_android
  cmd_clear_desktop
  ok "All build artifacts cleared"
}

# ── Help ───────────────────────────────────────────────
cmd_help() {
  cat <<EOF
${C}Recurrency Taskfile${N}

${Y}Usage:${N} ./taskfile [command]

${G}Main:${N}
  up        Start everything (DB + backend + frontend)
  down      Stop everything
  test      Run all tests
  coverage  Show coverage report
  reset     Reset database (⚠️  deletes data)

${G}Individual:${N}
  backend   Start backend only (port 8080)
  frontend  Start frontend only (port 1420)
  db        Start PostgreSQL only (port 5432)
  css       Build Tailwind CSS once

${G}Build:${N}
  build          Build all (api + web + android + desktop)
  build:app      Build api + web (all-in-one binary)
  build:api      Build backend API only
  build:web      Build web frontend only
  build:android  Build Android APK (auto-setup SDK if needed)
  build:desktop  Build desktop app

${G}Clear:${N}
  clear          Clear all build artifacts
  clear:app      Clear api + web artifacts
  clear:api      Clear API artifacts
  clear:web      Clear web artifacts
  clear:android  Clear Android artifacts
  clear:desktop  Clear desktop artifacts
  clear:all      Clear everything

${Y}Examples:${N}
  ./taskfile up           # Start all
  ./taskfile test         # Run tests
  ./taskfile coverage     # Check coverage
  ./taskfile reset        # Clean database
  ./taskfile build:app    # Build all-in-one
EOF
}

# ── Dispatch ──────────────────────────────────────────
case "${1:-help}" in
  up)           cmd_up ;;
  down|stop)    cmd_down ;;
  test)         cmd_test ;;
  coverage)     cmd_coverage ;;
  reset)        cmd_reset ;;
  backend)      cmd_backend ;;
  frontend)     cmd_frontend ;;
  db)           cmd_db ;;
  css)           cmd_css ;;
  build)          cmd_build ;;
  build:app)      cmd_build_app ;;
  build:api)      cmd_build_api ;;
  build:web)      cmd_build_web ;;
  build:android)  cmd_build_android ;;
  build:desktop)  cmd_build_desktop ;;
  clear)          cmd_clear ;;
  clear:app)      cmd_clear_app ;;
  clear:api)      cmd_clear_api ;;
  clear:web)      cmd_clear_web ;;
  clear:android)  cmd_clear_android ;;
  clear:desktop)  cmd_clear_desktop ;;
  clear:all)      cmd_clear_all ;;
  help|*)         cmd_help ;;
esac